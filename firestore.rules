rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && isEmailVerified() && request.auth.token.email == 'tiwariff07@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && isOwner(userId) && isValidId(userId) && (
        incoming().keys().hasAll([
          'uid', 'name', 'email', 'loginProvider', 'createdAt', 'lastActive', 
          'totalGenerations', 'userLanguage', 'userPlatformPreference', 'role', 'isPremium'
        ]) &&
        incoming().keys().size() == 11 &&
        incoming().uid == userId &&
        incoming().name is string && incoming().name.size() <= 200 &&
        incoming().email is string && incoming().email.size() <= 200 &&
        incoming().loginProvider is string && incoming().loginProvider.size() <= 50 &&
        incoming().createdAt is timestamp &&
        incoming().lastActive is timestamp &&
        incoming().totalGenerations is int && incoming().totalGenerations >= 0 &&
        incoming().userLanguage is string && incoming().userLanguage.size() <= 50 &&
        incoming().userPlatformPreference is string && incoming().userPlatformPreference.size() <= 50 &&
        incoming().role == 'user' &&  // Prevent self-assigned admin roles during creation
        incoming().isPremium == false  // Block self-assigned premium status
      );

      allow update: if isSignedIn() && (
        // Admin update overrides
        isAdmin() ||
        // Owner updates preferences & operational fields only
        (isOwner(userId) && (
          incoming().uid == existing().uid &&
          incoming().email == existing().email &&
          incoming().createdAt == existing().createdAt &&
          incoming().role == existing().role &&
          incoming().isPremium == existing().isPremium &&
          incoming().keys().size() == 11 &&
          incoming().name is string && incoming().name.size() <= 200 &&
          incoming().loginProvider is string && incoming().loginProvider.size() <= 50 &&
          incoming().lastActive is timestamp &&
          incoming().totalGenerations is int && incoming().totalGenerations >= 0 &&
          incoming().userLanguage is string && incoming().userLanguage.size() <= 50 &&
          incoming().userPlatformPreference is string && incoming().userPlatformPreference.size() <= 50 &&
          // Enforce exact change lists for the user actions (e.g. updating preferences/activity stats)
          incoming().diff(existing()).affectedKeys().hasOnly([
            'lastActive', 'totalGenerations', 'userLanguage', 'userPlatformPreference', 'name'
          ])
        ))
      );

      allow delete: if isAdmin();
    }

    // Generations Collection
    match /generations/{generationId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Enforce security at rule level to prevent client-side query scraping
      allow list: if isSignedIn() && (
        isAdmin() || 
        (resource.data.userId == request.auth.uid)
      );

      allow create: if isSignedIn() && isValidId(generationId) && (
        incoming().keys().hasAll([
          'userId', 'topic', 'platform', 'tone', 'niche', 'language', 'duration', 'timestamp'
        ]) &&
        incoming().keys().size() == 8 &&
        incoming().userId == request.auth.uid &&
        incoming().topic is string && incoming().topic.size() <= 500 &&
        incoming().platform is string && incoming().platform.size() <= 100 &&
        incoming().tone is string && incoming().tone.size() <= 100 &&
        incoming().niche is string && incoming().niche.size() <= 100 &&
        incoming().language is string && incoming().language.size() <= 100 &&
        incoming().duration is string && incoming().duration.size() <= 100 &&
        incoming().timestamp is timestamp
      );

      allow update, delete: if isAdmin();
    }

    // Feedback Collection
    match /feedback/{feedbackId} {
      allow get: if isAdmin();
      allow list: if isAdmin();

      allow create: if isSignedIn() && isValidId(feedbackId) && (
        incoming().keys().hasAll([
          'userId', 'userName', 'userEmail', 'feedbackText', 'rating', 'timestamp'
        ]) &&
        incoming().keys().size() == 6 &&
        incoming().userId == request.auth.uid &&
        incoming().userName is string && incoming().userName.size() <= 200 &&
        incoming().userEmail is string && incoming().userEmail.size() <= 200 &&
        incoming().feedbackText is string && incoming().feedbackText.size() <= 5000 &&
        incoming().rating is int && incoming().rating >= 1 && incoming().rating <= 5 &&
        incoming().timestamp is timestamp
      );

      allow update, delete: if isAdmin();
    }

    // Activity Logs Collection
    match /activityLogs/{logId} {
      allow get: if isAdmin();
      allow list: if isAdmin();

      allow create: if isSignedIn() && isValidId(logId) && (
        incoming().keys().hasAll([
          'userId', 'userEmail', 'activityType', 'timestamp', 'metadata'
        ]) &&
        incoming().keys().size() == 5 &&
        incoming().userId == request.auth.uid &&
        incoming().userEmail is string && incoming().userEmail.size() <= 200 &&
        incoming().activityType is string && incoming().activityType.size() <= 100 &&
        incoming().timestamp is timestamp &&
        incoming().metadata is string && incoming().metadata.size() <= 2000
      );

      allow update, delete: if isAdmin();
    }
  }
}
